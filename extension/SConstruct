#!/usr/bin/env python

# extension/SConstruct - GDExtension shim build (TASK-001.03).
#
# Structurally mirrors ~/git/jumpnbump/extension/SConstruct: SConscript
# into third_party/godot-cpp's own SConstruct, pinning api_version to
# Godot 4.7. Links the Mojo-built static library (core/build-output/lib/
# libdopewars.a) as an env.File(...) so a rebuilt core lib triggers a
# relink here.
#
# SConscript()-included scripts run with Python's cwd changed to their
# own directory, so custom.py has to be passed by absolute path via
# godot-cpp's own `customs` export hook.

import os
import subprocess

customs = [File("custom.py").srcnode().abspath]
env = SConscript("../third_party/godot-cpp/SConstruct", {"api_version": "4.7", "customs": customs})

# Wrap the compiler in ccache when present. Same env object godot-cpp
# just returned, so this lands on its ~200 binding sources too.
ccache = env.WhereIs("ccache")
if ccache:
    env["CC"] = "{} {}".format(ccache, env["CC"])
    env["CXX"] = "{} {}".format(ccache, env["CXX"])

# Linux: godot-cpp's static lib assembles a giant `ar rcs` command line
# that can exceed MAX_ARG_STRLEN. Route ARCOM through a response file.
if env["platform"] == "linux":
    from SCons.Platform import TempFileMunge

    env["TEMPFILE"] = TempFileMunge
    env["ARCOM"] = "${TEMPFILE('%s')}" % env["ARCOM"]

env.Append(CPPPATH=["src/", "../include"])
sources = Glob("src/*.cpp")

# Link core/build-output/lib/libdopewars.a as env.File(...) rather than
# a bare -ldopewars: SCons only tracks the .a as a real input this way,
# so a rebuilt core lib triggers a relink here.
core_lib = env.File("../core/build-output/lib/libdopewars.a")
env.Append(LIBS=[core_lib])

# The Mojo runtime, in shared form and with an rpath so Godot can dlopen the
# GDExtension without LD_PRELOAD.
#
# Why this is not optional: `mojo build --emit object` leaves the allocator
# entry points (KGEN_CompilerRT_AlignedAlloc/Free, and whatever else the
# standard library pulls in) undefined, expecting the final link to resolve them.
# The static libdopewars.a cannot satisfy them because it *is* the object that
# needs them, so a shim that links only the .a links fine (the linker allows
# undefined symbols in a shared object) and then fails at dlopen() inside Godot
# with "undefined symbol: KGEN_CompilerRT_AlignedFree". Linking the runtime
# resolves them at build time and makes the failure a compile error instead of a
# runtime one.
#
# Discovered the hard way by adding dw_world_align to the shim: the TASK-001.03
# smoke test passed without this because nothing it called reached the runtime's
# allocator. A bridge test that exercises the wider ABI surface is what exposed
# it, which is the argument for that test existing.
#
# The path is located through the venv's own interpreter rather than hard-coded,
# so a Mojo version bump that moves the library changes nothing here. If the
# library is missing, the build stops with a clear message rather than producing
# an extension that cannot load.
mojo_runtime_dir = None
for candidate_python in (
    os.path.join("..", "core", ".venv", "bin", "python"),
    os.path.join("..", "core", ".venv", "bin", "python3"),
):
    if not os.path.exists(candidate_python):
        continue
    located = subprocess.check_output(
        [
            candidate_python,
            "-c",
            "import pathlib,sys; "
            "print(next(p for p in pathlib.Path(sys.prefix).rglob('libKGENCompilerRTShared.so')).parent)",
        ],
        text=True,
    ).strip()
    if located:
        mojo_runtime_dir = located
    break

if not mojo_runtime_dir:
    raise SCons.Errors.UserError(
        "libKGENCompilerRTShared.so not found under core/.venv — run `task core:build` "
        "(it provisions the venv) before building the extension."
    )

env.Append(LIBPATH=[mojo_runtime_dir], LIBS=["KGENCompilerRTShared"])
if env["platform"] == "linux":
    env.Append(RPATH=[mojo_runtime_dir])
elif env["platform"] == "macos":
    env.Append(LINKFLAGS=["-Wl,-rpath,{}".format(mojo_runtime_dir)])

# macOS: Apple's newer default linker (ld-prime, Xcode 26+) enforces
# 8-byte alignment on Mach-O archive members. `ar` from Command Line
# Tools produces archives that don't always satisfy this; the older
# ld_classic linker (still shipped, deprecated but functional) links
# them cleanly. Same workaround as ~/git/jumpnbump/extension/SConstruct.
#
# .gdextension's [libraries] entry for macOS names a *.framework
# directory (no arch suffix) containing one flat Mach-O binary. Build
# it directly here -- no Contents/Info.plist nesting required for a
# GDExtension's own primary library.
if env["platform"] == "macos":
    env.Append(LINKFLAGS=["-Wl,-ld_classic"])
    bundle_name = "libdopewars.macos.{}.framework".format(env["target"])
    library = env.SharedLibrary(
        "../game/bin/{}/{}".format(bundle_name, bundle_name.removesuffix(".framework")),
        source=sources,
    )
else:
    library = env.SharedLibrary(
        "../game/bin/libdopewars{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
        source=sources,
    )
env.Depends(library, core_lib)

Default(library)
