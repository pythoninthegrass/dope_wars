; Engine configuration file for the Dope Wars Godot project.
;
; The window is sized to the prototype's 44rem design width (index.html:63) at
; 16px/rem. Unlike the prototype, the game fills the whole client area: there
; is no browser page around a 660px window, and no in-window titlebar, because
; the OS draws both. The height is what the prototype's 620px viewport needs
; to show all twelve drugs without scrolling.
;
; canvas_items/keep_width pins the horizontal scale to that fixed Win98 chrome
; width, so widening the window would only stretch it.
;
; The window is not resizable at all (resizable=false, maximize_disabled=true).
; Both tables are capped at the twelve drugs of DW_NUM_DRUGS -- every drug
; can be available at once, at any borough -- and twelve rows
; measure 236px against the 329px the tables already get at this height, so
; there is no size the player could need that this one does not already cover.
; Resizing is also visibly broken on macOS: Godot renders into an unflipped
; view's CAMetalLayer, so every height change composites one frame with the
; content displaced by the full delta and undrawn black under the title bar.

config_version=5

[application]

config/name="Dope Wars"
config/description="Dope Wars for Windows 1.2.0.0 (1999) ruleset, Mojo core / C ABI / C++ GDExtension / GDScript."
config/features=PackedStringArray("4.7")
run/main_scene="res://presentation/main.tscn"

[display]

window/size/viewport_width=704
window/size/viewport_height=620
window/size/window_width_override=704
window/size/window_height_override=620
window/size/resizable=false
window/size/maximize_disabled=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"

[internationalization]

; Every display string is a tr() key; this is the compiled English table that
; resolves them (game/translations/strings.csv). A key with no row renders as
; the key itself, which is what the ui_flow test guards against.
locale/translations=PackedStringArray("res://translations/strings.en.translation")
